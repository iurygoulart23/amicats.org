NODE_ENV=test
PORT=3333
DATABASE_URL=postgresql://amicats:amicats@localhost:5433/amicats_test
# Origem do site (CORS + checagem de Origin + links em e-mails)
WEB_ORIGIN=http://localhost:3000
# Em produção: .amicats.org
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Seed
SEED_ADMIN_EMAIL=admin@amicats.org
SEED_ADMIN_SENHA=troque-esta-senha

# E-mail (Resend). Vazio = e-mails só vão para o log.
RESEND_API_KEY=
MAIL_FROM="Amicats <nao-responda@amicats.org>"

# Backblaze B2 (API compatível com S3). Vazio = upload desativado.
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=catalogo-gatos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket, usada para montar a URL das fotos
S3_PUBLIC_URL=https://f005.backblazeb2.com/file/catalogo-gatos
TAREFAS_TOKEN=token-de-teste
MP_WEBHOOK_SECRET=segredo-webhook-teste
