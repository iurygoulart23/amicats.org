    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "DB_TEMP_NOME=amicats-db-e2e DB_TEMP_PORTA=5435 SEED_ADMIN_EMAIL=admin@amicats.org SEED_ADMIN_SENHA=troque-esta-senha npm --prefix api run db:temp && playwright test",
